[Unit]
Description=kkRepo dev Native runtime
Wants=network-online.target kkrepo.service kkrepo-scanner.service
After=network-online.target docker.service kkrepo.service kkrepo-scanner.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=kkrepo
Group=kkrepo
EnvironmentFile=-/opt/kkrepo/scanner/scanner.env
Environment=KKREPO_DEPLOY_ROOT=/opt/kkrepo/runtime/native
Environment=KKREPO_ENV_FILE=/opt/kkrepo/runtime/config/kkrepo.env
Environment=KKREPO_RUNTIME=native
Environment=KKREPO_HEALTH_URL=http://127.0.0.1:8091/actuator/health/readiness
Environment="KKREPO_INSTANCE_APPLICATION_ARGS=--server.port=8090 --management.server.port=8091 --management.metrics.tags.runtime=native"
ExecStartPre=/usr/bin/test -x /opt/kkrepo/bin/kkrepo-runtime-deploy.sh
ExecStart=/opt/kkrepo/bin/kkrepo-runtime-deploy.sh start
ExecStop=/opt/kkrepo/bin/kkrepo-runtime-deploy.sh stop
TimeoutStartSec=180
TimeoutStopSec=60
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
